# Públicas por diseño (van al navegador). Los secretos NUNCA se versionan.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública de la app (invitaciones y enlaces de correo). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo para consultas y reclamos sobre datos personales (aparece en /terminos y /privacidad).
NEXT_PUBLIC_CORREO_PRIVACIDAD=
# Pago manual de una finca adicional (solo servidor; en Vercel, sin NEXT_PUBLIC_). Sin NEQUI_* la pantalla pide esperar los datos al equipo.
NEQUI_NUMERO=
NEQUI_TITULAR=
# Opcional: pesos por dólar para mostrar el valor aproximado en pesos junto al precio en dólares.
PESOS_POR_DOLAR=
