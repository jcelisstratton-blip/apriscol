# Públicas por diseño (van al navegador). Los secretos NUNCA se versionan.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# URL pública de la app (invitaciones y enlaces de correo). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo para consultas y reclamos sobre datos personales (aparece en /terminos y /privacidad).
NEXT_PUBLIC_CORREO_PRIVACIDAD=
